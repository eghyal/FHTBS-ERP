# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# JWT_SECRET: Cryptographic secret key for signing and verifying JSON Web Tokens.
# Must be at least 32 random characters in production (if unset, server auto-generates a persistent 64-byte / 128-hex cryptographic secret).
JWT_SECRET=

# SUPABASE POSTGRESQL CONFIGURATION (2-Engine Architecture: Local SQLite + Supabase PostgreSQL)
VITE_SUPABASE_URL=https://wxyfgfqaiqrfeofxemgu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_nFlOHMTWhFzBLKTwdcAVsg_Qk_o3FND

# SUPABASE_SERVICE_ROLE_KEY: Required for PostgREST backend replication when RLS on public.erp_sync_records is locked to service_role.
# Found in Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# DATABASE_URL / SUPABASE_DB_URL: Direct PostgreSQL Transaction Pooler URI (port 6543).
# Automatically executes DDL and enforces strict service_role RLS on public.erp_sync_records at startup.
DATABASE_URL=
SUPABASE_DB_URL=
